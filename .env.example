# Copy to .env for local Docker Compose / development.
# Never commit .env or place bot/API tokens in this file.
ADMIN_PASSWORD=replace-this-with-a-long-random-password
DATA_DIR=./data
DEFAULT_TZ=Asia/Tehran
PORT=8080
COOKIE_SECURE=0
SESSION_DAYS=7
HTTP_TIMEOUT=22
TICK_SECONDS=15
SCHEDULER_ENABLED=1
SEND_DELAY=0.8

# Optional. Translation provider keys can instead be set in the authenticated panel.
# The application persists provider keys in the local database and masks them in the UI.
# (Do not check real API keys into source control.)
